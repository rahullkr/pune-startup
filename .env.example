POSTGRES_DB=pune_startup
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=app_user
RABBITMQ_PASSWORD=change_me_locally
RABBITMQ_VHOST=/
RABBITMQ_VHOST_URLENCODED=%2F
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=false
SPRING_RABBITMQ_VIRTUALHOST=/
SPRING_RABBITMQ_SSL_ENABLED=false

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pune_startup
SPRING_DATASOURCE_USERNAME=app_user
SPRING_DATASOURCE_PASSWORD=change_me_locally

ADMIN_API_KEY=replace_me
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_SESSION_TTL=PT720H
VITE_API_BASE_URL=/api/v1

INGESTION_SCHEDULER_ENABLED=true
INGESTION_SCHEDULER_POLL_INTERVAL=PT1M
INGESTION_SCHEDULER_INITIAL_DELAY=PT1M
INGESTION_SCHEDULER_MISSED_RUN_GRACE=PT15M

SCRAPER_REQUIRE_ENV=false
RABBITMQ_SSL_ENABLED=false
SCRAPER_MAX_MESSAGES=0
SCRAPER_IDLE_TIMEOUT_SECONDS=300
SCRAPER_RABBITMQ_PREFETCH=1
SCRAPER_HTTP_TIMEOUT_SECONDS=20
SCRAPER_HTTP_RETRIES=2
SCRAPER_USER_AGENT=pune-startup-scraper/1.0

R2_ENABLED=true
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PRESIGN_EXPIRY=PT5M

RESUME_MAX_SIZE_BYTES=5242880
RESUME_MULTIPART_MAX_FILE_SIZE=6MB
RESUME_MAX_REQUEST_SIZE=7MB
RESUME_RETENTION_DAYS=30
RESUME_PARSE_TIMEOUT=PT30S
RESUME_MAX_PARSED_CHARACTERS=200000
RESUME_CLEANUP_ENABLED=true
RESUME_CLEANUP_INTERVAL=PT1H
RESUME_CLEANUP_INITIAL_DELAY=PT1M

LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
